# ----------------------
# Base image
# ----------------------
FROM node:20-alpine

# Set working directory
WORKDIR /app

# Copy package.json and package-lock.json (or pnpm-lock.yaml/yarn.lock)
COPY package*.json ./

# Install dependencies
RUN npm install

# Copy the rest of the code
COPY . .

# Expose Next.js dev port
EXPOSE 3000

# Start Next.js in dev mode with hot reload
CMD ["npm", "run", "dev"]